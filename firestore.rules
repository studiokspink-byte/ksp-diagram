rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 認証済みかつ指定ドメイン（@${COMPANY_DOMAIN}）のユーザーか判定する関数
    function isCompanyUser() {
      return request.auth != null 
          && request.auth.token.email != null
          && request.auth.token.email.endsWith('@${COMPANY_DOMAIN}');
    }

    // 共有図面データ: drawing/{drawingId}
    match /drawing/{drawingId} {
      allow read, write: if isCompanyUser();
    }

    // 会社共通プリセット: preset/{presetSlug}
    match /preset/{presetSlug} {
      allow read, write: if isCompanyUser();
    }

    // 個人データ: user/{uid}/prefs/{key} および user/{uid}/preset/{slug} 等
    match /user/{uid}/{document=**} {
      allow read, write: if request.auth != null 
                         && request.auth.uid == uid 
                         && isCompanyUser();
    }
  }
}
